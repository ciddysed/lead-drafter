# Copy this file to .env and fill in your own values. Never commit .env itself.

# Which LLM to use: "openai", "anthropic", or "gemini"
LLM_PROVIDER=gemini

# Only one of these needs to be set, matching LLM_PROVIDER above
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model name (e.g. gpt-4o-mini, claude-haiku-4-5, gemini-3.5-flash-lite)
# Note: "flash-lite" tier models have a much higher free daily quota than
# flagship "flash"/"pro" models -- gemini-3.6-flash's free tier is only
# 20 requests/day, nowhere near enough for a 12-case eval run (24 calls).
LLM_MODEL=gemini-3.5-flash-lite

# Google Sheets — path to your downloaded service-account credentials JSON
GOOGLE_SHEETS_CREDS_PATH=credentials.json

# The Google Sheet ID from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Drafts below this confidence score get flagged for extra-careful human review
REVIEW_CONFIDENCE_THRESHOLD=0.75

# Optional: who the outreach is signed from. Same for every lead (this is
# your business identity, not lead data) -- leave blank to omit a
# signature entirely rather than have the model invent one.
COMPANY_NAME=
SENDER_NAME=

# Optional: what the business does, in a sentence. The model may reference
# this in general terms, but grounding rules still apply to lead-specific
# claims -- it won't assume every lead's situation matches this description.
BUSINESS_DESCRIPTION=
